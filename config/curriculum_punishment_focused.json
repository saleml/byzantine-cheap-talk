{
  "name": "punishment_focused_curriculum",
  "description": "Scaffolding the punishment mechanism from simple to complex",
  "agents": [
    {
      "name": "Agent_1",
      "model": "mistralai/Mixtral-8x22B-Instruct-v0.1",
      "model_family": "Mixtral"
    },
    {
      "name": "Agent_2",
      "model": "Qwen/Qwen2.5-72B-Instruct",
      "model_family": "Qwen"
    },
    {
      "name": "Agent_3",
      "model": "meta-llama/Llama-3.3-70B-Instruct",
      "model_family": "Llama"
    },
    {
      "name": "Agent_4",
      "model": "deepseek-ai/DeepSeek-V3",
      "model_family": "DeepSeek"
    }
  ],
  "stages": [
    {
      "stage_num": 1,
      "name": "2-Player IPGG+P",
      "game": "IteratedPublicGoodsGame",
      "params": {
        "rounds": 3,
        "enable_punishment": true
      },
      "num_players": 2,
      "generate_lesson": true,
      "lesson_focus": "Direct reciprocity; punishment enables cooperation in dyads"
    },
    {
      "stage_num": 2,
      "name": "3-Player IPGG+P",
      "game": "IteratedPublicGoodsGame",
      "params": {
        "rounds": 5,
        "enable_punishment": true
      },
      "num_players": 3,
      "generate_lesson": true,
      "lesson_focus": "Third-party punishment; group size introduces free-rider problem in enforcement"
    },
    {
      "stage_num": 3,
      "name": "4-Player IPGG+P (7 rounds)",
      "game": "IteratedPublicGoodsGame",
      "params": {
        "rounds": 7,
        "enable_punishment": true
      },
      "num_players": 4,
      "generate_lesson": true,
      "lesson_focus": "Punishment must be targeted and consistent; indiscriminate punishment destroys cooperation"
    },
    {
      "stage_num": 4,
      "name": "IPGG+P (Target Task)",
      "game": "IteratedPublicGoodsGame",
      "params": {
        "rounds": 10,
        "enable_punishment": true
      },
      "num_players": 4,
      "is_target_task": true,
      "generate_lesson": false
    }
  ]
}
